# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key

# Expo Configuration (Mobile Apps)
# Add to app.json in each mobile app:
# {
#   "expo": {
#     "extra": {
#       "eas": {
#         "projectId": "your-eas-project-id"
#       }
#     }
#   }
# }

# Firebase Configuration (Android FCM)
# For each mobile app, create google-services.json from Firebase console:
# - JJ's IMEX Client: jjsimex-client project
# - JJ's IMEX Admin: jjsimex-admin project
# Files location:
# - jjsimex/apps/mobile-client/google-services.json
# - jjsimex/apps/mobile-admin/google-services.json

# Environment Type
NODE_ENV=development
